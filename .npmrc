# Pin direct dependencies to exact versions instead of ^/~ ranges going
# forward. Enforced in CI by scripts/check-pinned-deps.mjs.
save-exact=true

# npm's `min-release-age` (delay pulling same-day dependency releases) has a
# pnpm equivalent, `minimumReleaseAge`, but it landed in pnpm's 10.x line
# (default-enabled as of 11.x) and lives in pnpm-workspace.yaml / the pnpm
# user config, not .npmrc. This repo pins packageManager: pnpm@8.15.1, which
# predates that feature, so it is intentionally not configured here. Revisit
# once the repo's pinned pnpm version is bumped past the release that
# introduced minimumReleaseAge.
