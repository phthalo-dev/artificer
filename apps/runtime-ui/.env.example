# Base URL for runtime API reads (CloudFront URL in cloud, localhost in dev).
# Leave unset when using `pnpm dev:mock` — the Vite dev server serves mock API routes.
VITE_RUNTIME_URL=http://localhost:4100

# Cloud mode: send messages via wake API (enqueue + start EC2). Leave unset for local dev.
# VITE_WAKE_API_URL=https://xxxx.execute-api.us-east-1.amazonaws.com
# VITE_WAKE_API_TOKEN=
