// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String
  teams        TeamMember[]
  agents       Agent[]
  accounts     Account[]
  sessions     Session[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Team {
  id        String       @id @default(cuid())
  name      String
  members   TeamMember[]
  agents    Agent[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("teams")
}

model TeamMember {
  id     String @id @default(cuid())
  userId String
  teamId String
  role   Role   @default(MEMBER)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@map("team_members")
}

model Agent {
  id             String       @id @default(cuid())
  name           String
  status         AgentStatus  @default(STOPPED)
  ec2InstanceId  String?      @unique
  ec2PublicIp    String?
  ec2PrivateIp   String?

  // GitHub configuration (encrypted)
  githubUsername String
  githubEmail    String
  githubSshKey   String       @db.Text
  githubToken    String       @db.Text

  // GitHub Integration
  githubWebhookId String?    @unique // GitHub webhook ID
  repositories   String[]   @default([]) // List of repo full_names this agent handles
  
  // OpenCode configuration
  opencodeConfig Json         @default("{}")
  opencodePassword String?    // Encrypted password for OpenCode on EC2
  anthropicApiKey String      @db.Text

  // Relationships
  userId         String
  teamId         String?
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  team           Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // Activity
  activities     Activity[]
  metrics        AgentMetric[]
  
  // Observability
  agentSessions  AgentSession[]
  tokenUsage     TokenUsage[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId])
  @@index([teamId])
  @@index([status])
  @@map("agents")
}

model Activity {
  id          String       @id @default(cuid())
  agentId     String
  type        ActivityType
  description String       @db.Text
  metadata    Json         @default("{}")
  timestamp   DateTime     @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, timestamp])
  @@map("activities")
}

model AgentMetric {
  id         String   @id @default(cuid())
  agentId    String
  metricType String
  value      Float
  timestamp  DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, timestamp])
  @@index([metricType, timestamp])
  @@map("agent_metrics")
}

enum AgentStatus {
  STOPPED
  STARTING
  RUNNING
  ERROR
  STOPPING
}

enum ActivityType {
  COMMIT_CREATED
  PR_OPENED
  PR_REVIEWED
  PR_MERGED
  ISSUE_COMMENTED
  CODE_CHANGE
  ERROR
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

// Observability Models

model AgentSession {
  id            String   @id @default(cuid())
  agentId       String
  remoteId      String?  // OpenCode session ID on the remote server
  title         String?
  status        SessionStatus @default(ACTIVE)
  source        SessionSource @default(WEB) // How the session was created
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relationships
  agent         Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  
  // Observability
  messages      Message[]
  toolCalls     ToolCall[]
  fileEdits    FileEdit[]
  tokenUsage   TokenUsage[]

  @@index([agentId, createdAt])
  @@index([agentId, status])
  @@map("agent_sessions")
}

model Message {
  id           String       @id @default(cuid())
  sessionId    String
  role         MessageRole  // user, assistant, system
  content      String       @db.Text
  model        String?
  timestamp    DateTime     @default(now())
  
  // Relationships
  session      AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, timestamp])
  @@map("messages")
}

model ToolCall {
  id           String     @id @default(cuid())
  sessionId    String
  toolName     String
  arguments    Json       @default("{}")
  result       String?    @db.Text
  status       ToolCallStatus @default(PENDING)
  durationMs   Int?
  error        String?    @db.Text
  timestamp    DateTime   @default(now())
  
  // Relationships
  session      AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, timestamp])
  @@index([sessionId, toolName])
  @@map("tool_calls")
}

model FileEdit {
  id           String       @id @default(cuid())
  sessionId    String
  filePath     String
  operation    FileOperation // CREATE, EDIT, DELETE
  diff         String?      @db.Text
  content      String?      @db.Text
  timestamp    DateTime     @default(now())
  
  // Relationships
  session      AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, timestamp])
  @@map("file_edits")
}

model TokenUsage {
  id            String   @id @default(cuid())
  agentId       String
  sessionId     String?
  model         String
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  costUSD       Float    @default(0)
  durationMs    Int?
  timestamp     DateTime @default(now())
  
  // Relationships
  agent         Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  session       AgentSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([agentId, timestamp])
  @@index([agentId, model, timestamp])
  @@map("token_usage")
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ABORTED
}

enum SessionSource {
  WEB
  GITHUB
  SLACK
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ToolCallStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum FileOperation {
  CREATE
  EDIT
  DELETE
}
