---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Artificer" showToc={false}>
  <article>
    <h1>Artificer</h1>
    <p>
      Artificer runs AI coding agents that have their own GitHub identity — their own
      account, commits, and PRs, not yours. The agent is a git repo you can clone
      anywhere. Talk to it through a web UI, Slack, or Discord.
    </p>
    <p>
      <a href="/docs/getting-started/quickstart">Quickstart →</a>
      {' · '}
      <a href="/docs/introduction/how-it-works">How it works →</a>
    </p>
  </article>
</BaseLayout>
