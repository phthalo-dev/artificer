{
  "name": "artificer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Platform for managing remote AI coding agents on EC2 instances",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "lint": "vp lint",
    "clean": "vp run -r clean && rm -rf node_modules",
    "type-check": "vp run -r type-check",
    "test": "vp run -r test",
    "infra:deploy": "pnpm --filter artificer-infrastructure deploy:personal",
    "infra:sync-env": "pnpm --filter artificer-infrastructure sync:runtime-env",
    "link": "cd packages/runtime && npm link && cd ../cli && npm link",
    "unlink": "cd packages/cli && npm unlink -g && cd ../runtime && npm unlink -g",
    "changeset": "vp exec changeset",
    "version-packages": "vp exec changeset version",
    "publish-packages": "vp run -F @artificer-ai/runtime build && vp run -F @artificer-ai/runtime build:ui && vp run -F @artificer-ai/cli build && vp exec changeset publish",
    "release": "node scripts/publish.mjs",
    "prepare": "vp config",
    "check": "vp check",
    "fmt": "vp fmt",
    "lint:fix": "vp lint --fix",
    "verify": "vp run ci"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "2.31.0",
    "@types/node": "20.19.35",
    "typescript": "5.9.3",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.18.0"
  },
  "dependencies": {
    "bcryptjs": "2.4.3"
  }
}
