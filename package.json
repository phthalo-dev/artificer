{
  "name": "artificer",
  "version": "0.1.0",
  "private": true,
  "description": "Platform for managing remote AI coding agents on EC2 instances",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:migrate": "turbo run db:migrate",
    "db:studio": "cd apps/web && pnpm db:studio",
    "type-check": "turbo run type-check",
    "infra:deploy": "pnpm --filter artificer-infrastructure deploy:personal",
    "infra:sync-env": "pnpm --filter artificer-infrastructure sync:runtime-env"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "prettier": "^3.2.4",
    "turbo": "^1.12.4",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@8.15.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3"
  }
}
