{
  "name": "@artificer-ai/eval",
  "version": "0.1.3",
  "description": "Artificer identity eval driver and maintainer bench harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phthalo-dev/artificer.git",
    "directory": "packages/eval"
  },
  "type": "module",
  "engines": {
    "node": ">=21"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./bench": "./src/bench/main.ts",
    "./bench/report": "./src/bench/report.ts",
    "./bench/external": "./src/bench/external-agent.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@artificer-ai/runtime": "workspace:*",
    "dotenv": "16.6.1"
  },
  "devDependencies": {
    "@types/node": "20.19.35",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./bench": {
        "types": "./dist/bench/main.d.ts",
        "import": "./dist/bench/main.js"
      },
      "./bench/report": {
        "types": "./dist/bench/report.d.ts",
        "import": "./dist/bench/report.js"
      },
      "./bench/external": {
        "types": "./dist/bench/external-agent.d.ts",
        "import": "./dist/bench/external-agent.js"
      }
    }
  }
}
