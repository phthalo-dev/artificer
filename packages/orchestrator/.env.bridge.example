# Bridge sidecar — polls SQS and forwards to the local runtime container.
# Copy to .env and fill in values from `cdk deploy` outputs.

AWS_REGION=us-east-1
SQS_QUEUE_URL=
RUNTIME_INSTANCE_ID=
RUNTIME_URL=http://127.0.0.1:4100
HIBERNATE_IDLE_MS=900000
# BRIDGE_POLL_INTERVAL_MS=30000
# RUNTIME_AUTH_TOKEN=
