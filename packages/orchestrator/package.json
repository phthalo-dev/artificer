{
  "name": "@artificer/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "docker:build": "docker build --no-cache -t artificer-agent:test .",
    "docker:run": "docker compose up",
    "docker:test": "docker build -t artificer-agent:test . && docker run --rm -it artificer-agent:test /bin/bash",
    "docker:clean": "docker compose down -v"
  },
  "dependencies": {
    "@artificer/shared": "workspace:*",
    "@aws-sdk/client-ec2": "^3.500.0",
    "@aws-sdk/client-ssm": "^3.500.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "typescript": "^5.3.3"
  }
}
