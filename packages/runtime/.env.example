# LLM gateway. Defaults to OpenCode Zen (https://opencode.ai/docs/zen), which
# serves Claude, GPT, Gemini, Qwen, GLM, Kimi and more behind one API key. The
# model id selects the provider/API shape automatically.
#
# API key: the first of LLM_API_KEY / ZEN_API_KEY / ANTHROPIC_API_KEY is used.
LLM_API_KEY=sk-...

# Gateway base URL. Default is Zen. Point at a provider directly to bypass Zen,
# e.g. https://api.anthropic.com/v1 (with an Anthropic key) for Claude models.
# For OpenCode Go subscription models, use:
# LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_BASE_URL=https://opencode.ai/zen/v1

# Model preset (async-economy | ultra-budget | async-slow | quality-first | bench-budget |
# go-economy | go-flash | go-mimo | go-quality | go-minimax).
# Go presets require LLM_BASE_URL=https://opencode.ai/zen/go/v1 and a Go subscription key.
# Recommended Go preset for async value: go-economy.
# Sets default tiers and role->tier map. Override individual tiers with LLM_MODEL*
# or per-role tiers with RUNTIME_TIER_<ROLE> (e.g. RUNTIME_TIER_WORKER=high).
MODEL_PRESET=async-economy

# Optional explicit tier overrides (unset = use preset defaults):
# LLM_MODEL=gpt-5.4-mini
# LLM_MODEL_LOW=gpt-5-nano
# LLM_MODEL_HIGH=gpt-5.4
#
# Run `pnpm --filter @artificer/runtime models` for the full list with pricing.
# Switch presets at runtime from the Models page in runtime-ui (no restart needed).
# RUNTIME_TIER_REVIEWER=high

# Where all messages and work history are stored on disk
ARTIFICER_DATA_DIR=./data

# HTTP server port
PORT=4100

# Max concurrent in-flight LLM calls (higher is fine for async workloads)
RUNTIME_CONCURRENCY=4

# Max tool-use iterations within a single call
RUNTIME_MAX_ITERATIONS=24
# Optional lower cap for planner calls (bench uses 15)
# RUNTIME_MAX_ITERATIONS_PLANNER=15
# Wall-clock limit per LLM call (default 10m); failed runs let the FSM retry
# RUNTIME_MAX_CALL_DURATION_MS=600000

# Re-invoke the orchestrator for workstreams interrupted by a restart (set to
# "false" to disable; useful in dev where tsx watch restarts frequently)
RUNTIME_RESUME_ON_STARTUP=true

# Display name of this agent entity
AGENT_NAME=Artificer

# --- Post-edit diagnostics ---
# After edit_file/write_file, run the relevant language checker (e.g. ruff for
# Python, tsc for TypeScript) and feed any errors back to the model so it fixes
# them in the same turn. Checkers that are not installed are silently skipped.
# Set to "false" to turn diagnostics off entirely.
RUNTIME_DIAGNOSTICS=true
# Per-checker timeout in milliseconds (tsc is project-wide and can be slow).
RUNTIME_DIAGNOSTICS_TIMEOUT_MS=20000
# Max errors surfaced per file.
RUNTIME_DIAGNOSTICS_MAX_PER_FILE=20
# TypeScript checking is project-wide via `tsc --noEmit`, which is slower than
# the others. Set to "false" to disable just the TypeScript checker.
RUNTIME_DIAGNOSTICS_TYPESCRIPT=true

# --- Context borrowing (search, spill, microcompact, file cache) ---
# Max chars returned to the model per tool invocation before spilling to disk.
RUNTIME_TOOL_RESULT_MAX_CHARS=12000
# Aggregate cap on tool-result chars returned across a single run.
RUNTIME_TOOL_RESULT_MAX_PER_RUN_CHARS=80000
# Replace bulky prior-run tool outputs with a compact digest between calls.
RUNTIME_MICROCOMPACT_ENABLED=true
# LRU size for per-workstream "recently read files" hints in context.
RUNTIME_FILE_CACHE_MAX_ENTRIES=64
# Require ripgrep (rg) on PATH for grep/glob tools; set false to allow fallback errors.
RUNTIME_REQUIRE_RG=true

# --- Cross-call agentic compaction (LLM summary of older run history) ---
# RUNTIME_COMPACTION_ENABLED=true
# RUNTIME_COMPACTION_SOFT_CHARS=80000
# RUNTIME_COMPACTION_HARD_CHARS=160000
# RUNTIME_COMPACTION_KEEP_RECENT=3
# RUNTIME_COMPACTION_MIN_RUNS=4
# RUNTIME_COMPACTION_MAX_INPUT_CHARS=120000
# RUNTIME_COMPACTION_SUMMARY_MAX_TOKENS=4096
# Mid-call LLM compaction inside the tool loop (Pi-style overflow retry + threshold compact).
# RUNTIME_WITHIN_CALL_COMPACT_ENABLED=true
# RUNTIME_WITHIN_CALL_COMPACT_SOFT_CHARS=350000
# RUNTIME_WITHIN_CALL_COMPACT_HARD_CHARS=450000
# RUNTIME_WITHIN_CALL_COMPACT_KEEP_RECENT=8
# RUNTIME_WITHIN_CALL_COMPACT_MAX_PER_CALL=2
# RUNTIME_OVERFLOW_RETRY_ENABLED=true

# --- Shell execution ---
# Use detached spawn + process-group SIGKILL for run_shell on Unix (default on).
# Set to "false" to fall back to child_process.exec. Windows always uses exec.
# RUNTIME_SHELL_PROCESS_GROUP=true

# --- Bench single-loop mode ---
# One worker loop (no planner/reviewer). Used by bench --single-loop and smoke declare-done.
# RUNTIME_SINGLE_LOOP=false
# When single-loop is on, require a git diff before declare_done can finish (default true).
# Set to "false" for smoke/echo-only completion tests.
# RUNTIME_REQUIRE_GIT_DIFF_FOR_DONE=true

# --- VCR (deterministic HTTP record/playback for tests) ---
# RUNTIME_VCR=record|playback
# RUNTIME_VCR_CASSETTE=./src/llm/fixtures/vcr-minimal.json
# RUNTIME_VCR_FILTER=/chat/completions

# --- Within-call safety (loop detection, context hygiene) ---
# Soft loop-detection threshold: warn the model after this many repeated tool patterns.
RUNTIME_LOOP_SOFT_THRESHOLD=3
# Hard loop-detection threshold: stop the call after this many repeated tool patterns.
RUNTIME_LOOP_HARD_THRESHOLD=6
# Max consecutive tool mistakes before forcing a stop.
RUNTIME_MISTAKE_MAX=4
# Max chars per tool result kept in the within-call context window.
RUNTIME_WITHIN_CALL_MAX_TOOL_RESULT_CHARS=50000
# Max total text chars in the within-call context window.
RUNTIME_WITHIN_CALL_MAX_TOTAL_CHARS=500000
# Drop stale read_file results when the file changes mid-call. Set to "false" to disable.
RUNTIME_OUTDATED_READ_INVALIDATION=true
# Log per-request diagnostics for within-call safety. Set to "true" to enable.
RUNTIME_REQUEST_DIAGNOSTICS=false

# --- Skills composition ---
# Each archetype ships with distilled skills (superpowers + impeccable: shape,
# impeccable-craft, design-critique, etc.) under packages/runtime/skills
# — always composed
# into sub-agent prompts. Optionally add more from an external directory when
# an agent config declares `skills: ['react', 'design']`. Two layouts are
# accepted per name: `<dir>/<name>.md` and `<dir>/<name>/SKILL.md`. Missing
# names are silently skipped. External skills override bundled ones on name
# collision.
# RUNTIME_SKILLS_DIR=./skills
# RUNTIME_SKILLS_ENABLED=true
# RUNTIME_SKILLS_MAX_TOTAL_CHARS=24000

# --- GitHub (the agent's OWN account, not yours) ---
# Part of this project's vision is that the agent has its own identity and
# credentials. When set, the git/gh/run_shell tools clone over HTTPS, push,
# open PRs, and comment on PRs as this account. Locally you paste a token here;
# in a cloud container the same GITHUB_TOKEN is injected into the environment.
#
# Personal access token for the agent's GitHub account. Scopes: `repo`
# (and `workflow` if it will touch GitHub Actions). GH_TOKEN also works.
GITHUB_TOKEN=
# Commit author identity (the agent account). Use the account's GitHub-provided
# noreply email (Settings > Emails) to keep commits verified and private.
GITHUB_USER_NAME=
GITHUB_USER_EMAIL=
