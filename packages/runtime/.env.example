# The agent's own Anthropic API key (its identity, not a developer's key)
ANTHROPIC_API_KEY=sk-ant-...

# Models by complexity tier. Each call picks a tier based on its role (or an
# orchestrator override). ANTHROPIC_MODEL is the "medium" tier.
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_LOW=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_HIGH=claude-opus-4-8

# Optional per-role tier overrides (low | medium | high). Defaults:
# communicator=low, orchestrator=medium, planner=high, reviewer=medium, worker=high
# RUNTIME_TIER_WORKER=medium
# RUNTIME_TIER_REVIEWER=high

# Where all messages and work history are stored on disk
ARTIFICER_DATA_DIR=./data

# HTTP server port
PORT=4100

# Max concurrent in-flight LLM calls
RUNTIME_CONCURRENCY=2

# Max tool-use iterations within a single call
RUNTIME_MAX_ITERATIONS=24

# Re-invoke the orchestrator for workstreams interrupted by a restart (set to
# "false" to disable; useful in dev where tsx watch restarts frequently)
RUNTIME_RESUME_ON_STARTUP=true

# Display name of this agent entity
AGENT_NAME=Artificer
