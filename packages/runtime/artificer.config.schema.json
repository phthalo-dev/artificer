{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://artificer.dev/schemas/artificer.config.schema.json",
  "title": "Artificer Agent Config",
  "description": "Configuration for an Artificer agent (artificer.config.json).",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Human-facing name of the agent. Used in logs, the runtime UI, and as the default exec-dir subfolder."
    },
    "description": {
      "type": "string",
      "description": "Short description of what this agent does."
    },
    "preset": {
      "type": "string",
      "description": "Named model preset that seeds the three complexity tiers and the per-role tier map. Overridden by explicit 'models' or LLM_MODEL* env vars.",
      "enum": [
        "async-economy",
        "ultra-budget",
        "async-slow",
        "quality-first",
        "bench-budget",
        "go-economy",
        "go-flash",
        "go-mimo",
        "go-quality",
        "go-minimax",
        "open-weights-economy",
        "baseten-open-weights"
      ]
    },
    "models": {
      "type": "object",
      "description": "Override individual tier model IDs. Any tier not listed falls back to the active preset.",
      "additionalProperties": false,
      "properties": {
        "low": {
          "type": "string",
          "description": "Model ID for the low-complexity tier (routing, comms, lightweight review)."
        },
        "medium": {
          "type": "string",
          "description": "Model ID for the medium-complexity tier (planning, implementation)."
        },
        "high": {
          "type": "string",
          "description": "Model ID for the high-complexity tier (orchestrator escalation only)."
        }
      }
    },
    "roleTiers": {
      "type": "object",
      "description": "Override which complexity tier each role uses. Any role not listed falls back to the preset's role map.",
      "additionalProperties": false,
      "properties": {
        "communicator": { "$ref": "#/$defs/modelTier" },
        "orchestrator": { "$ref": "#/$defs/modelTier" },
        "planner": { "$ref": "#/$defs/modelTier" },
        "reviewer": { "$ref": "#/$defs/modelTier" },
        "worker": { "$ref": "#/$defs/modelTier" },
        "librarian": { "$ref": "#/$defs/modelTier" }
      }
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1,
      "description": "Max concurrent in-flight LLM calls across all workstreams. Defaults to 2."
    },
    "maxIterationsPerCall": {
      "type": "integer",
      "minimum": 1,
      "description": "Max tool-use iterations allowed within a single LLM call before forcing a stop. Defaults to 24."
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "description": "HTTP port for the runtime server. Defaults to 4100."
    },
    "execDir": {
      "type": "string",
      "description": "Root directory where runs, workstreams, and workspace artifacts are persisted. Defaults to ~/.artificer/<name>."
    },
    "github": {
      "type": "object",
      "description": "Agent GitHub identity settings.",
      "additionalProperties": false,
      "properties": {
        "watchInterval": {
          "type": "string",
          "pattern": "^\\d+(ms|s|m|h|d)$",
          "description": "Polling interval for the agent's own PRs and notifications (e.g. '5m', '30s'). Omit to disable."
        }
      }
    },
    "repos": {
      "type": "array",
      "description": "Repositories this instance checks out once and reuses as git worktrees.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "url", "baseBranch"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "url": { "type": "string", "minLength": 1 },
          "baseBranch": { "type": "string", "pattern": "^\\S+$" }
        }
      }
    },
    "executor": {
      "description": "Worker executor backend for work roles (planner, worker, reviewer). Defaults to 'llm' (internal tool-use loop). Set to 'cursor-agent', 'claude-code', or 'opencode' to delegate work to those CLIs instead.",
      "oneOf": [
        {
          "type": "string",
          "enum": ["llm", "cursor-agent", "claude-code", "opencode"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["cursor-agent", "claude-code", "opencode"]
            },
            "model": {
              "type": "string",
              "description": "Model to pass to the executor via --model (e.g. 'claude-sonnet-4-6')."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "agent"],
          "properties": {
            "type": { "const": "acp" },
            "agent": {
              "enum": ["opencode"],
              "description": "Certified agent preset."
            },
            "args": { "type": "array", "items": { "type": "string" } },
            "env": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "model": { "type": "string", "minLength": 1 },
            "mode": { "type": "string", "minLength": 1 },
            "resumes": {
              "type": "boolean",
              "description": "Whether the agent can resume sessions (session/resume or session/load). Defaults to false (true for presets)."
            },
            "timeout": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "Per-run timeout in milliseconds. Defaults to 600000."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "command", "args"],
          "properties": {
            "type": { "const": "acp" },
            "command": {
              "type": "string",
              "minLength": 1,
              "description": "Executable that speaks the Agent Client Protocol over stdio."
            },
            "args": { "type": "array", "items": { "type": "string" } },
            "env": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "model": { "type": "string", "minLength": 1 },
            "mode": { "type": "string", "minLength": 1 },
            "resumes": {
              "type": "boolean",
              "description": "Whether the agent can resume sessions (session/resume or session/load). Defaults to false (true for presets)."
            },
            "timeout": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "Per-run timeout in milliseconds. Defaults to 600000."
            }
          }
        }
      ]
    },
    "quota": {
      "type": "object",
      "description": "Usage quotas, budgets, and provider failover routing.",
      "additionalProperties": false,
      "properties": {
        "reservePercent": {
          "type": "number",
          "description": "Percent of each window held for communicator replies. Default 10."
        },
        "routes": {
          "type": "array",
          "description": "Ordered execution chain — first route is primary, rest are failovers.",
          "items": { "$ref": "#/$defs/executionRoute" }
        },
        "accounts": {
          "type": "array",
          "description": "Legacy quota accounts (migrated to routes at runtime).",
          "items": { "$ref": "#/$defs/quotaAccount" }
        }
      }
    },
    "workspaceServices": {
      "type": "object",
      "description": "Identity-repo overrides for workspace services declared by a target repo's .artificer/workspace.json — disable services or override their port ranges.",
      "additionalProperties": false,
      "properties": {
        "disabled": {
          "type": "array",
          "description": "Names of services to disable even if declared by the target repo.",
          "items": { "type": "string" }
        },
        "overrides": {
          "type": "object",
          "description": "Per-service field overrides, keyed by service name.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "portRange": {
                "type": "array",
                "description": "Override the [min, max] port range for this service.",
                "items": { "type": "integer" },
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "description": "Identity git sync settings — controls automatic commit/push of memories and config changes.",
      "additionalProperties": false,
      "properties": {
        "autoCommit": {
          "type": "boolean",
          "description": "Commit changes to the identity repo automatically (memories, config updates). Default: false."
        },
        "autoPush": {
          "type": "boolean",
          "description": "Push commits to the remote after each autoCommit. Requires autoCommit: true. Default: false."
        },
        "commitPrefix": {
          "type": "string",
          "description": "Prefix for auto-generated commit messages. Default: 'memory:' for memories, 'config:' for config changes."
        },
        "remote": {
          "type": "string",
          "description": "Git remote name to push to. Default: 'origin'."
        },
        "branch": {
          "type": "string",
          "description": "Branch to push to. Default: the current branch."
        },
        "pullInterval": {
          "type": "string",
          "pattern": "^\\d+(ms|s|m|h|d)$",
          "description": "How often to pull identity from origin (e.g. '5m', '30s', '1d'). Omit to disable."
        },
        "distillWorkstreams": {
          "type": "boolean",
          "description": "After a workstream finishes, spawn a librarian to distill claim/entity memories from the chronicle. Default: true. Set false to disable."
        },
        "embeddings": {
          "type": "object",
          "description": "Optional meaning-based memory search. When enabled, Artificer stores a numeric fingerprint per memory in identity/embeddings.json and combines that with normal word matching. Disabled by default.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "When true, write/update vectors in identity/embeddings.json and use them during query_memories. Default: false."
            },
            "provider": {
              "type": "string",
              "enum": ["openai", "local", "none"],
              "description": "Where fingerprints come from. 'local' is on-device and needs no API key. 'openai' expects OPENAI_API_KEY or LLM_API_KEY (and an optional model id). 'none' disables vectors."
            },
            "model": {
              "type": "string",
              "description": "Optional model id for the openai provider (e.g. text-embedding-3-small)."
            }
          }
        }
      }
    }
  },
  "$defs": {
    "modelTier": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "description": "Complexity tier: low (cheap/fast), medium (balanced), high (most capable)."
    },
    "quotaAccount": {
      "type": "object",
      "required": ["id", "mode", "windows"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "mode": { "type": "string", "enum": ["metered", "windowed", "opaque"] },
        "onExhausted": { "type": "string", "enum": ["wait", "failover"] },
        "pollIntervalMs": { "type": "integer", "minimum": 1000 },
        "windows": {
          "type": "array",
          "items": { "$ref": "#/$defs/quotaWindow" }
        },
        "failover": {
          "type": "array",
          "items": { "$ref": "#/$defs/failoverTarget" }
        },
        "unitWeights": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        }
      }
    },
    "quotaWindow": {
      "type": "object",
      "required": ["id", "unit", "period", "limit"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "unit": { "type": "string", "enum": ["dollars", "tokens", "requests"] },
        "period": {
          "type": "string",
          "enum": ["rolling5h", "daily", "weekly", "monthly", "fixed"]
        },
        "scope": { "type": "string", "enum": ["global", "workstream"] },
        "limit": { "type": "number", "minimum": 0 },
        "warnAtPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "blockAtPercent": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "failoverTarget": {
      "type": "object",
      "required": ["id", "accountId"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "accountId": { "type": "string" },
        "roles": { "type": "array", "items": { "type": "string" } },
        "executor": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["llm", "cursor-agent", "claude-code", "opencode"]
            },
            { "type": "object" }
          ]
        },
        "onExhausted": { "type": "string", "enum": ["wait", "failover"] },
        "llm": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseURL": { "type": "string" },
            "apiKeyEnv": { "type": "string" },
            "preset": { "type": "string" },
            "models": {
              "type": "object",
              "properties": {
                "low": { "type": "string" },
                "medium": { "type": "string" },
                "high": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "executionRoute": {
      "type": "object",
      "required": ["id", "accountId", "mode", "windows", "execution", "models"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "accountId": { "type": "string" },
        "mode": { "type": "string", "enum": ["metered", "windowed", "opaque"] },
        "windows": {
          "type": "array",
          "items": { "$ref": "#/$defs/quotaWindow" }
        },
        "execution": {
          "type": "string",
          "enum": ["llm", "cursor-agent", "claude-code", "opencode"]
        },
        "llm": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseURL": { "type": "string" },
            "apiKeyEnv": { "type": "string" }
          }
        },
        "presetId": { "type": "string" },
        "models": {
          "type": "object",
          "required": ["low", "medium", "high"],
          "properties": {
            "low": { "type": "string" },
            "medium": { "type": "string" },
            "high": { "type": "string" }
          }
        },
        "roleTiers": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/modelTier" }
        },
        "roles": { "type": "array", "items": { "type": "string" } },
        "pollIntervalMs": { "type": "integer", "minimum": 1000 }
      }
    }
  }
}
