{
  "name": "@artificer/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=21"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "clean": "rm -rf dist",
    "docker:build": "docker build -t artificer-runtime:dev .",
    "docker:run": "docker compose up"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@hono/node-server": "^1.13.7",
    "dotenv": "^16.4.5",
    "hono": "^4.6.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3"
  }
}
