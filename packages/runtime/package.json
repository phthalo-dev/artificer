{
  "name": "@artificer-ai/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=21"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "models": "tsx src/scripts/list-models.ts",
    "bench": "tsx bench/src/main.ts",
    "bench:run": "tsx bench/src/main.ts",
    "bench:eval": "bash bench/eval/run-eval.sh",
    "bench:eval:deepswe": "bash bench/eval/run-deepswe-eval.sh",
    "bench:report": "tsx bench/src/report.ts",
    "bench:swebench": "tsx bench/src/main.ts --suite tasks/mini-suite.json --preset async-economy",
    "bench:swebench:eval": "BENCH_RESULTS_DIR=bench/results/async-economy/mini-suite bash bench/eval/run-eval.sh",
    "bench:swebench:report": "BENCH_RESULTS_DIR=bench/results/async-economy/mini-suite tsx bench/src/report.ts",
    "bench:full:swebench": "pnpm bench:swebench && pnpm bench:swebench:eval && pnpm bench:swebench:report",
    "bench:deepswe": "tsx bench/src/main.ts --suite tasks/deepswe-mini-suite.json --preset async-economy",
    "bench:deepswe:typescript": "tsx bench/src/main.ts --suite tasks/deepswe-typescript-mini.json --preset async-economy",
    "bench:deepswe:typescript:quality-first": "tsx bench/src/main.ts --suite tasks/deepswe-typescript-mini.json --preset quality-first",
    "bench:deepswe:eval": "BENCH_RESULTS_DIR=bench/results/async-economy/deepswe-mini-suite bash bench/eval/run-deepswe-eval.sh",
    "bench:deepswe:report": "BENCH_RESULTS_DIR=bench/results/async-economy/deepswe-mini-suite tsx bench/src/report.ts",
    "bench:full:deepswe": "pnpm bench:deepswe && pnpm bench:deepswe:eval && pnpm bench:deepswe:report",
    "bench:swebench:quality-first": "tsx bench/src/main.ts --suite tasks/mini-suite.json --preset quality-first",
    "bench:swebench:ultra-budget": "tsx bench/src/main.ts --suite tasks/mini-suite.json --preset ultra-budget",
    "bench:swebench:async-slow": "tsx bench/src/main.ts --suite tasks/mini-suite.json --preset async-slow",
    "bench:swebench:bench-budget": "tsx bench/src/main.ts --suite tasks/mini-suite.json --preset bench-budget",
    "bench:swebench:go-economy": "tsx bench/src/main.ts --suite tasks/mini-suite.json --preset go-economy",
    "bench:swebench:go-flash": "tsx bench/src/main.ts --suite tasks/mini-suite.json --preset go-flash",
    "bench:swebench:go-mimo": "tsx bench/src/main.ts --suite tasks/mini-suite.json --preset go-mimo",
    "bench:swebench:go-quality": "tsx bench/src/main.ts --suite tasks/mini-suite.json --preset go-quality",
    "bench:swebench:go-minimax": "tsx bench/src/main.ts --suite tasks/mini-suite.json --preset go-minimax",
    "bench:deepswe:go-economy": "tsx bench/src/main.ts --suite tasks/deepswe-mini-suite.json --preset go-economy",
    "bench:deepswe:go-flash": "tsx bench/src/main.ts --suite tasks/deepswe-mini-suite.json --preset go-flash",
    "bench:deepswe:go-quality": "tsx bench/src/main.ts --suite tasks/deepswe-mini-suite.json --preset go-quality",
    "bench:deepswe:typescript:go-economy": "tsx bench/src/main.ts --suite tasks/deepswe-typescript-mini.json --preset go-economy",
    "bench:deepswe:typescript:go-quality": "tsx bench/src/main.ts --suite tasks/deepswe-typescript-mini.json --preset go-quality",
    "build:ui": "cd ../ui && pnpm build && cd ../runtime && rm -rf ui-dist && cp -r ../ui/dist ui-dist",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "clean": "rm -rf dist",
    "docker:build": "docker build -t artificer-runtime:dev .",
    "docker:run": "docker compose up"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/openai": "^3.0.67",
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@hono/node-server": "^1.13.7",
    "ai": "^6.0.193",
    "dotenv": "^16.4.5",
    "hono": "^4.6.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3"
  }
}
